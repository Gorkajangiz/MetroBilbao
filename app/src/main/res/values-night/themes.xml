<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MetroBilbao" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/metro_red</item>
        <item name="colorPrimaryVariant">@color/metro_red_dark</item>
        <item name="colorOnPrimary">@color/text_on_banner</item>
        <item name="colorSecondary">@color/metro_orange</item>
        <item name="colorOnSecondary">@color/text_on_banner</item>
        <item name="colorAccent">@color/metro_orange</item>

        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorTertiary">@color/text_tertiary</item>


        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>


        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/bg_primary</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="31">200</item>
    </style>

    <style name="Theme.MetroBilbao.Dialog" parent="Theme.MaterialComponents.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="colorPrimary">@color/metro_orange</item>
        <item name="colorAccent">@color/metro_orange</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.MetroBilbao.BottomSheetDialog" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="bottomSheetStyle">@style/MetroBottomSheetStyle</item>
        <item name="colorPrimary">@color/metro_orange</item>
        <item name="colorAccent">@color/metro_orange</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

</resources>