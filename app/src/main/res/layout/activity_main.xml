<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>


    <FrameLayout
        android:id="@+id/navBarContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:elevation="16dp">


        <LinearLayout
            android:id="@+id/navBar"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_navbar_glass"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:gravity="center_vertical">


            <View
                android:id="@+id/pillIndicator"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="invisible"/>

            <FrameLayout
                android:id="@+id/tabMapa"
                android:layout_width="64dp"
                android:layout_height="48dp"
                android:layout_margin="4dp">
                <View
                    android:id="@+id/pillMapa"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_tab_pill_active"
                    android:alpha="0"/>
                <ImageView
                    android:id="@+id/iconMapa"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_map"
                    android:contentDescription="Mapa"/>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/tabViaje"
                android:layout_width="64dp"
                android:layout_height="48dp"
                android:layout_margin="4dp">
                <View
                    android:id="@+id/pillViaje"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_tab_pill_active"
                    android:alpha="0"/>
                <ImageView
                    android:id="@+id/iconViaje"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_trip"
                    android:contentDescription="Viaje"/>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/tabNoticias"
                android:layout_width="64dp"
                android:layout_height="48dp"
                android:layout_margin="4dp">
                <View
                    android:id="@+id/pillNoticias"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_tab_pill_active"
                    android:alpha="0"/>
                <ImageView
                    android:id="@+id/iconNoticias"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_news"
                    android:contentDescription="Noticias"/>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/tabAvisos"
                android:layout_width="64dp"
                android:layout_height="48dp"
                android:layout_margin="4dp">
                <View
                    android:id="@+id/pillAvisos"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_tab_pill_active"
                    android:alpha="0"/>
                <ImageView
                    android:id="@+id/iconAvisos"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_alerts"
                    android:contentDescription="Avisos"/>
            </FrameLayout>

        </LinearLayout>
    </FrameLayout>


    <FrameLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_primary"
        android:clickable="true"
        android:focusable="true"
        android:elevation="100dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/splashLogo"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@mipmap/logo"/>

            <TextView
                android:id="@+id/splashText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Metro Bilbao"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/splashProgress"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:indeterminate="true"
                app:indicatorColor="@color/metro_orange"
                app:trackColor="@color/separator"
                app:trackCornerRadius="2dp"
                app:trackThickness="4dp"/>

        </LinearLayout>
    </FrameLayout>
</FrameLayout>