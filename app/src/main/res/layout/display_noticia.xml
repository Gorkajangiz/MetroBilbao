<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="28dp">

        <!-- Asa de arrastre -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="#55FFFFFF"
            android:layout_marginBottom="16dp"/>

        <!-- Imagen opcional con esquinas redondeadas -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/detailImgCard"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/detailImgNoticia"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Título -->
        <TextView
            android:id="@+id/detailTituloNoticia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.1"
            android:layout_marginTop="16dp"/>

        <!-- Fecha legible -->
        <TextView
            android:id="@+id/detailFechaNoticia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"
            android:layout_marginTop="6dp"/>

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22FFFFFF"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"/>

        <!-- Cuerpo -->
        <TextView
            android:id="@+id/detailDescNoticia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E0FFFFFF"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.35"/>

        <!-- Link opcional -->
        <Button
            android:id="@+id/detailBtnLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Abrir noticia completa"
            android:visibility="gone"
            android:layout_marginTop="24dp"/>
    </LinearLayout>
</ScrollView>