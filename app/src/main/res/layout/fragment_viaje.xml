<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:paddingBottom="110dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Origen" android:textStyle="bold"/>
    <Spinner android:id="@+id/spinnerOrigen" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginBottom="12dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Destino" android:textStyle="bold"/>
    <Spinner android:id="@+id/spinnerDestino" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnConsultarViaje"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Consultar ruta"
        android:enabled="false"/>

    <!-- FIX #9: feedback mientras carga GTFS -->
    <ProgressBar
        android:id="@+id/progressViaje"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"/>

    <TextView android:id="@+id/txtRutaResultado" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="16sp"
        android:textStyle="bold" android:layout_marginTop="16dp"/>
    <TextView android:id="@+id/txtTiempo" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="14sp"
        android:layout_marginTop="4dp"/>
    <TextView android:id="@+id/txtPrecio" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="14sp"
        android:layout_marginTop="4dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Próximos trenes (60 min)" android:textStyle="bold"
        android:layout_marginTop="16dp"/>
    <ListView android:id="@+id/listProximosTrenes" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp"/>
</LinearLayout>